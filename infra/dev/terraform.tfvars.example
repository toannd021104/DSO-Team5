aws_profile       = "guru"
aws_region        = "us-east-1"
kubernetes_version = "1.34"

# Replace with your current public IPv4 address /32 before applying.
allowed_cidr_blocks = ["203.0.113.10/32"]

# Lab defaults; increase only when the exercise requires it.
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 3
